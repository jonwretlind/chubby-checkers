; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chubby Checkers"
config/description="Chubby Checkers is a 2D checkers game with a 1950s diner theme: Hamburgers v. Hotdogs on a red-and-cream checkered tablecloth with a groovy retro touch."
config/version="0.1.0"
run/main_scene="uid://0ql36nplnxlq"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.8745098, 0.8509804, 0.7176471, 1)
boot_splash/image="uid://bxc4ovfbr3dif"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=3000

[audio]

buses/default_bus_layout="uid://cmqq7gm6r5xwj"

[autoload]

GameSettings="*uid://d4sahvlufmcr"
Transition="*uid://71gbcex8ecke"

[display]

window/size/viewport_width=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gitot/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.89, 0.8633, 0.7298, 1)
